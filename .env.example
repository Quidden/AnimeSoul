# Local development only. pnpm setup generates a private local password.
SITE_URL=http://localhost:8021
API_URL=http://127.0.0.1:8020
API_HOST=127.0.0.1
API_PORT=8020
PUBLIC_INDEXING=false
DEMO_CATALOG=true
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://animesoul:replace-with-random-local-password@127.0.0.1:54329/animesoul
REDIS_URL=redis://127.0.0.1:6391
# Disabled by default in every deployment. Credentials will remain server-side.
ALLOW_YUMMY=false
PAYMENTS_ENABLED=false
