# Local settings. pnpm setup / Setup Docker.ps1 generate private secrets.
# Compose uses compiled frontends; development allows localhost/file mail in the API.
APP_ENV=development
SITE_URL=http://localhost:8021
ADMIN_URL=http://localhost:8022
# Random 32-byte hex key, private and required for MFA. pnpm setup generates it.
MFA_ENCRYPTION_KEY=
# Google web OAuth client; callback is SITE_URL/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local files in ignored artifacts/dev-mail. Use smtp for actual delivery.
MAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
API_URL=http://127.0.0.1:8020
API_HOST=127.0.0.1
API_PORT=8020
# Server-to-server frame-search identity channel. Same random secret in web and API.
# Generate: openssl rand -hex 32. Blank disables forwarded visitor identities.
INTERNAL_PROXY_SECRET=
# Exact socket peers only; local development may use 127.0.0.1,::1.
INTERNAL_PROXY_TRUSTED_IPS=
# Docker: set to web to verify the caller against the current web service DNS addresses.
INTERNAL_PROXY_TRUSTED_HOSTS=
# Persistent writable storage for profile images. Default: artifacts/profile-media.
# Back up this directory together with PostgreSQL; use a persistent volume in production.
PROFILE_MEDIA_DIR=
# Public GIPHY web integration key. Search/media requests go directly from browsers to GIPHY.
GIPHY_API_KEY=
# Optional trace.moe key for screenshot search. Blank uses its free IP quota; server-side only.
TRACE_MOE_API_KEY=
PUBLIC_INDEXING=false
DEMO_CATALOG=true
# Opt in to the isolated native PostgreSQL cluster instead of Docker.
LOCAL_POSTGRES=false
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://animesoul:replace-with-random-local-password@127.0.0.1:54329/animesoul
REDIS_URL=redis://127.0.0.1:6391
# Disabled by default in every deployment. Credentials will remain server-side.
ALLOW_YUMMY=false
ALLOW_KODIK=false
YUMMY_TOKEN=
KODIK_TOKEN=
# Optional direct HLS access; missing keys/errors fall back to the embedded player.
ALLOW_KODIK_DIRECT=false
KODIK_PRIVATE_KEY=
# Optional comma-separated CDN host allowlist.
KODIK_MEDIA_HOSTS=
# Development only. Blank discovers the public IP; forbidden in production.
KODIK_VIEWER_IP=
PAYMENTS_ENABLED=false

# Run the durable PostgreSQL catalog worker with pnpm dev.
CATALOG_WORKER=false
# Optional shared writable directory for web/API diagnostics (7 days, 4 MiB/day).
# Default: artifacts/diagnostics in the project root. Set a shared volume in production.
DIAGNOSTICS_DIR=
