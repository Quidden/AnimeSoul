# Copy to .env.server, fill private values; never commit the resulting file.
COMPOSE_PROJECT_NAME=animesoul
ANIMESOUL_ENV_FILE=.env.server
APP_ENV=production
SITE_DOMAIN=anime.example.com
ADMIN_DOMAIN=admin.example.com
SITE_URL=https://anime.example.com
ADMIN_URL=https://admin.example.com
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Preserve the existing key when moving a database containing MFA credentials.
# Generate for a NEW installation only: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
PUBLIC_INDEXING=false
DEMO_CATALOG=false
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_KODIK=false
ALLOW_YUMMY=false
ALLOW_KODIK_DIRECT=false
KODIK_TOKEN=
YUMMY_TOKEN=
KODIK_PRIVATE_KEY=
KODIK_MEDIA_HOSTS=
KODIK_VIEWER_IP=
GIPHY_API_KEY=
TRACE_MOE_API_KEY=
# Private server-to-server secret, identical in web and API; generate: openssl rand -hex 32.
# Empty secret disables forwarded visitor identities. Never expose it as NEXT_PUBLIC_*.
INTERNAL_PROXY_SECRET=
INTERNAL_PROXY_TRUSTED_IPS=
INTERNAL_PROXY_TRUSTED_HOSTS=web
