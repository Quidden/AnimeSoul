# Copy to .env in this directory. Do not commit real secrets.
ANIMESOUL_DOMAIN=anime.example.com
ANIMESOUL_PUBLIC_ORIGIN=https://anime.example.com
ANIMESOUL_WEBSITE_DEVELOPMENT=0
ANIMESOUL_BIND_ADDRESS=0.0.0.0
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
# URL-encode password characters in the URL if needed.
ANIMESOUL_DATABASE_URL=postgresql+psycopg://animesoul:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/animesoul
ANIMESOUL_OWNER_EMAIL=dogemmoze@gmail.com
# Public web API key for the profile GIF picker.
ANIMESOUL_GIPHY_API_KEY=
ANIMESOUL_AUTH_GOOGLE_CLIENT_ID=
ANIMESOUL_AUTH_GOOGLE_CLIENT_SECRET=
ANIMESOUL_SMTP_HOST=
ANIMESOUL_SMTP_PORT=587
ANIMESOUL_SMTP_USER=
ANIMESOUL_SMTP_PASSWORD=
ANIMESOUL_SMTP_FROM=
ANIMESOUL_SMTP_TLS=1
YUMMYANIME_TOKEN=
ANIMESOUL_KODIK_PUBLIC_KEY=
ANIMESOUL_KODIK_PRIVATE_KEY=
