# Same Docker Compose stack as production, available only on this PC.
# Copy to app/deploy/.env. Existing credentials belong in that file too.
ANIMESOUL_DOMAIN=localhost
ANIMESOUL_PUBLIC_ORIGIN=https://localhost
ANIMESOUL_WEBSITE_DEVELOPMENT=0
ANIMESOUL_BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
# The database hostname is db inside Docker. Keep the same password in both values.
ANIMESOUL_DATABASE_URL=postgresql+psycopg://animesoul:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/animesoul
ANIMESOUL_OWNER_EMAIL=dogemmoze@gmail.com
ANIMESOUL_GIPHY_API_KEY=
# Google Web application redirect URI: https://localhost/api/auth/google/callback
ANIMESOUL_AUTH_GOOGLE_CLIENT_ID=
ANIMESOUL_AUTH_GOOGLE_CLIENT_SECRET=
ANIMESOUL_SMTP_HOST=
ANIMESOUL_SMTP_PORT=587
ANIMESOUL_SMTP_USER=
ANIMESOUL_SMTP_PASSWORD=
ANIMESOUL_SMTP_FROM=
ANIMESOUL_SMTP_TLS=1
YUMMYANIME_TOKEN=
ANIMESOUL_KODIK_PUBLIC_KEY=
ANIMESOUL_KODIK_PRIVATE_KEY=
