<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:endColor="#5B1B86"
                android:startColor="#B04BFF" />
        </shape>
    </item>
    <item android:bottom="16dp" android:left="16dp" android:right="16dp" android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="#09080D" />
            <stroke android:width="2dp" android:color="#F2DFFF" />
        </shape>
    </item>
</layer-list>
