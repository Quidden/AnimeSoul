{
  "name": "@animesoul/database",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./fixtures": {
      "types": "./dist/src/fixtures.d.ts",
      "import": "./dist/src/fixtures.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@animesoul/contracts": "workspace:*",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
