{
  "name": "animesoul",
  "version": "0.1.8-beta.3",
  "displayVersion": "0.1.8.3",
  "description": "Локальный аниме-каталог и плеер с прогрессом просмотра",
  "author": "Quidden",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && node launcher/build-desktop.mjs",
    "desktop:installer": "node launcher/build-desktop.mjs installer",
    "desktop:portable": "node launcher/build-desktop.mjs portable",
    "test": "npm run build && node --test tests/domain-logic.test.mjs tests/rendered-html.test.mjs tests/watch-party.test.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.quidden.animesoul",
    "productName": "AnimeSoul",
    "buildVersion": "0.1.8.3",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "desktop/**/*",
      "launcher/**/*",
      "dist/**/*",
      "public/**/*",
      "local-storage-server.mjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/og.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AnimeSoul",
      "artifactName": "AnimeSoul-Setup-0.1.8.3-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AnimeSoul-Portable-0.1.8.3-${arch}.${ext}"
    }
  }
}
